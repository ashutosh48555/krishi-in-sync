@model AgriSyncIndia.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Agronomist Account - AgriSync India";
}

<div class="row justify-content-center my-4">
    <div class="col-12 col-md-9 col-lg-6">
        <div class="card card-agri p-4 p-md-5 border-0 shadow">
            
            <!-- Branding Header -->
            <div class="text-center mb-4">
                <div class="d-inline-flex p-3 bg-success bg-opacity-10 rounded-circle text-success mb-2">
                    <i class="bi bi-person-plus-fill fs-2"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">Create an Account</h3>
                <p class="text-muted small">Register as an Agronomist or Farm Manager to monitor climate telemetry</p>
            </div>

            <form asp-controller="Account" asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                <!-- Full Name -->
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label small fw-semibold text-muted"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-person"></i></span>
                        <input asp-for="FullName" class="form-control border-start-0" placeholder="e.g. Dr. Harpreet Singh" />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <!-- Email Address -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold text-muted"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control border-start-0" placeholder="harpreet@pau.edu.in" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- Organizational Role & Affiliated Cluster -->
                <div class="row g-2 mb-3">
                    <div class="col-12 col-sm-6">
                        <label asp-for="Role" class="form-label small fw-semibold text-muted"></label>
                        <select asp-for="Role" class="form-select">
                            <option value="Agronomist">Senior Agronomist</option>
                            <option value="Farm Manager">Farm Operations Manager</option>
                            <option value="Field Operator">Field IoT Operator</option>
                            <option value="Research Scholar">Agricultural Researcher</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="AffiliatedFarmCluster" class="form-label small fw-semibold text-muted"></label>
                        <select asp-for="AffiliatedFarmCluster" class="form-select">
                            @if (ViewBag.Clusters != null)
                            {
                                foreach (string clusterName in ViewBag.Clusters)
                                {
                                    <option value="@clusterName">@clusterName</option>
                                }
                            }
                            else
                            {
                                <option value="IARI Pusa Smart Farm - New Delhi">IARI Pusa Smart Farm - New Delhi</option>
                            }
                        </select>
                        <span asp-validation-for="AffiliatedFarmCluster" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Password & Confirm Password -->
                <div class="row g-2 mb-3">
                    <div class="col-12 col-sm-6">
                        <label asp-for="Password" class="form-label small fw-semibold text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control border-start-0" type="password" placeholder="Min. 6 chars" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-check2-circle"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control border-start-0" type="password" placeholder="Confirm password" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Protocol Compliance Checkbox -->
                <div class="form-check mb-4">
                    <input asp-for="AgreeToAgrometCompliance" class="form-check-input" type="checkbox" id="complianceCheck" />
                    <label class="form-check-label small text-muted" for="complianceCheck">
                        I confirm adherence to ICAR/IMD Agromet sensor telemetry and crop advisory standards.
                    </label>
                    <span asp-validation-for="AgreeToAgrometCompliance" class="text-danger small d-block"></span>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-success w-100 py-2 fw-semibold shadow-sm mb-3">
                    <i class="bi bi-check-circle-fill me-1"></i> Register & Access Dashboard
                </button>
            </form>

            <div class="text-center pt-3 border-top text-muted small">
                Already have an authorized account? 
                <a asp-controller="Account" asp-action="Login" class="text-success fw-bold text-decoration-none">Sign In here</a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
