@{
    var lang = Context.Lang();
    string T(string k) => Localizer.T(lang, k);
    ViewData["Title"] = T("st.403.t");
}

<div class="auth center">
    <div class="card">
        <div class="ico crit" style="margin: 0 auto 16px; width:44px; height:44px; border-radius:12px; display:grid; place-items:center; background:color-mix(in srgb, var(--crit) 14%, transparent); color:var(--crit);">
            @await Html.Icon("triangle-alert", 24)
        </div>
        <h1 class="sec-title" style="margin-bottom:8px;">@T("st.403.t")</h1>
        <p class="sub" style="margin-bottom:20px;">@T("st.403.b")</p>
        <div class="cta" style="justify-content:center;">
            <a asp-controller="Climate" asp-action="Dashboard" class="btn">@T("dash.title")</a>
            <a asp-controller="Account" asp-action="Login" class="btn sec">@T("login.title")</a>
        </div>
    </div>
</div>
