@model AgriSyncIndia.ViewModels.AutomationViewModel
@{
    var lang = Context.Lang();
    string T(string k) => Localizer.T(lang, k);
    ViewData["Title"] = T("au.title");
    var hasSoilReading = Model.SoilMetrics.VolumetricWaterContent.HasValue;
    var soilStatus = Model.SoilMetrics.Status;
}
@section Head { <link rel="stylesheet" href="~/css/pages-b.css" asp-append-version="true" /> }

<div class="dh">
    <div class="dt">
        <h1 class="sec-title">@T("au.title")</h1>
        <p class="sub">@T("au.sub")</p>
    </div>
    <div class="dact">
        <button type="button" class="btn sec sm" data-open-dialog="vpd-dialog">@await Html.Icon("book-open", 14)<span>@T("guide.btn")</span></button>
        @if (User.Identity?.IsAuthenticated == true && Permissions.IsOperator(User))
        {
            <form asp-action="SimulateAnomaly" method="post" class="d-inline" data-confirm="@T("au.sim.confirm")">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn sec sm btn-sim" title="@T("au.sim.title")">
                    @await Html.Icon("zap", 14)@T("au.simulate.btn")
                </button>
            </form>
        }
    </div>
</div>

<div class="bento">
    <!-- Soil Telemetry Card -->
    <section class="card c12" aria-labelledby="soil-h">
        <div class="ch">@await Html.Icon("droplet")<span id="soil-h">@T("au.soil.title")</span><span class="sim">@T("card.modelled")</span></div>
        <div class="mets">
            <div class="met">
                <span class="k">@await Html.Icon("droplet", 14)@T("au.soil.vwc")</span>
                <span class="v">@(hasSoilReading ? ViewFormat.N(Model.SoilMetrics.VolumetricWaterContent, 1) : "—")<small>%</small></span>
                @if (soilStatus.HasValue)
                {
                    <span class="st @soilStatus.Value.Tone mt-6">@T("soil." + soilStatus.Value.Key)</span>
                }
                else
                {
                    <span class="sub mt-4">@T("dash.noupdate")</span>
                }
            </div>
            <div class="met">
                <span class="k">@await Html.Icon("thermometer", 14)@T("au.soil.temp")</span>
                <span class="v">@(Model.SoilMetrics.RootZoneTemperature.HasValue ? ViewFormat.N(Model.SoilMetrics.RootZoneTemperature, 1) : "—")<small>°C</small></span>
                <span class="sub mt-4">@(Model.SoilMetrics.RootZoneTemperature.HasValue ? T("zone.drip") : T("dash.noupdate"))</span>
            </div>
        </div>
    </section>

    <!-- Rules Table -->
    <section class="card c7" aria-labelledby="rules-h">
        <div class="ch">
            @await Html.Icon("cpu")
            <span id="rules-h">@T("au.rules")</span>
            <span class="sp">@Model.ExistingRules.Count</span>
        </div>
        <p class="sub mb-14">@T("au.scope")</p>

        @if (Model.ExistingRules.Count == 0)
        {
            <p class="empty">@T("au.empty")</p>
        }
        else
        {
            <div class="rules-list">
                @foreach (var rule in Model.ExistingRules)
                {
                    var access = ControlAccess.ForRule(User, rule);
                    var ownerKey = ControlAccess.Owner(User, rule);
                    <article class="rule-item">
                        <div class="rule-main">
                            <div class="rule-sentence">
                                <b>@RuleDisplay.Sentence(lang, rule)</b>
                            </div>
                            @if (!string.IsNullOrEmpty(rule.Description))
                            {
                                <div class="rule-desc">@rule.Description</div>
                            }
                            <div class="rule-meta">
                                <span class="st @(rule.IsActive ? "" : "mute")">
                                    @await Html.Icon(rule.IsActive ? "check" : "power", 12)
                                    @(rule.IsActive ? T("au.active") : T("au.paused"))
                                </span>
                                <span class="rule-owner">@T("au.owner." + ownerKey)</span>
                            </div>
                        </div>
                        <div class="rule-actions">
                            @if (access.Allowed)
                            {
                                <form asp-action="ToggleRule" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ruleId" value="@rule.RuleId" />
                                    <button type="submit" class="btn sec sm" title="@(rule.IsActive ? T("au.paused") : T("au.active"))">
                                        @await Html.Icon("power", 14)
                                    </button>
                                </form>
                                <form asp-action="DeleteRule" method="post" class="d-inline" data-confirm="@T("au.delete.q")">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ruleId" value="@rule.RuleId" />
                                    <button type="submit" class="btn sec sm btn-del" title="@T("au.delete")">
                                        @await Html.Icon("trash", 14)
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge-ro" title="@T(access.ReasonKey ?? "au.ro.why")">@T("au.ro")</span>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <!-- Add Rule Form -->
    <section class="card c5" aria-labelledby="add-h">
        <div class="ch">
            @await Html.Icon("plus")
            <span id="add-h">@T("au.add")</span>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="presets-row mb-12">
                <span class="sub preset-label">@T("au.presets.title")</span>
                <button type="button" class="btn-preset" data-preset-metric="Relative Humidity" data-preset-op=">" data-preset-val="80" data-preset-act="Exhaust" data-preset-on="true" data-preset-note="@T("au.preset.note.monsoon")">@T("au.preset.monsoon")</button>
                <button type="button" class="btn-preset" data-preset-metric="Temperature" data-preset-op="<" data-preset-val="12" data-preset-act="Exhaust" data-preset-on="false" data-preset-note="@T("au.preset.note.frost")">@T("au.preset.frost")</button>
                <button type="button" class="btn-preset" data-preset-metric="VPD" data-preset-op=">" data-preset-val="1.3" data-preset-act="Misting" data-preset-on="true" data-preset-note="@T("au.preset.note.mist")">@T("au.preset.mist")</button>
            </div>
            <form asp-action="CreateRule" method="post" class="form-grid">
                @Html.AntiForgeryToken()
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="notice form-err-box">
                        @await Html.Icon("triangle-alert")
                        <div>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@FormText.Error(lang, error.ErrorMessage)</div>
                            }
                        </div>
                    </div>
                }

                <div class="fg">
                    <label class="fl" asp-for="NewRule.ConditionVariable">@T("au.f.metric")</label>
                    <select asp-for="NewRule.ConditionVariable" class="inp">
                        <option value="Temperature">@T("rm.temp") (°C)</option>
                        <option value="Relative Humidity">@T("rm.hum") (%)</option>
                        <option value="VPD">@T("rm.vpd") (kPa)</option>
                    </select>
                </div>

                <div class="frow">
                    <div class="fg fg-1">
                        <label class="fl" asp-for="NewRule.Operator">@T("au.f.op")</label>
                        <select asp-for="NewRule.Operator" class="inp">
                            <option value=">">@T("au.op.gt") (&gt;)</option>
                            <option value="<">@T("au.op.lt") (&lt;)</option>
                            <option value=">=">@T("au.op.ge") (&gt;=)</option>
                            <option value="<=">@T("au.op.le") (&lt;=)</option>
                        </select>
                    </div>
                    <div class="fg fg-1">
                        <label class="fl" asp-for="NewRule.ThresholdValue">@T("au.f.thr")</label>
                        <input asp-for="NewRule.ThresholdValue" type="number" step="any" class="inp" placeholder="e.g. 28" required />
                    </div>
                </div>

                <div class="fg">
                    <label class="fl" asp-for="NewRule.ActuatorId">@T("au.f.act")</label>
                    <select asp-for="NewRule.ActuatorId" class="inp">
                        <option value="">@T("au.f.choose")</option>
                        @foreach (var a in Model.Actuators)
                        {
                            <option value="@a.ActuatorId">@RuleDisplay.Device(lang, a.Name) (@RuleDisplay.ZoneName(lang, a.Zone?.Name ?? ""))</option>
                        }
                    </select>
                </div>

                <div class="fg">
                    <label class="fl">@T("au.f.do")</label>
                    <div class="seg" role="radiogroup">
                        <label class="seg-item">
                            <input type="radio" asp-for="NewRule.TurnOn" value="true" checked />
                            <span>@T("au.f.on")</span>
                        </label>
                        <label class="seg-item">
                            <input type="radio" asp-for="NewRule.TurnOn" value="false" />
                            <span>@T("au.f.off")</span>
                        </label>
                    </div>
                </div>

                <div class="fg">
                    <label class="fl" asp-for="NewRule.Description">@T("au.f.note")</label>
                    <input asp-for="NewRule.Description" class="inp" placeholder="@T("au.f.note")" maxlength="200" />
                </div>

                <label class="check mt-4">
                    <input asp-for="NewRule.IsActive" type="checkbox" />
                    <span>@T("au.f.enable")</span>
                </label>

                <button type="submit" class="btn full mt-10">
                    @await Html.Icon("plus", 14)@T("au.add")
                </button>
            </form>
        }
        else
        {
            <div class="signin-box">
                <p class="sub mb-16">@T("au.signin.why")</p>
                <a asp-controller="Account" asp-action="Login" class="btn full">@T("au.signin")</a>
            </div>
        }
    </section>

    <!-- Actuators Overview -->
    <section class="card c12" aria-labelledby="act-h">
        <div class="ch">@await Html.Icon("power")<span id="act-h">@T("au.act.title")</span><span class="sim">@T("card.modelled")</span></div>
        <div class="tscroll" tabindex="0" role="region" aria-label="@T("au.act.title")">
            <table class="ttab">
                <caption class="sr-only">@T("au.act.title")</caption>
                <thead>
                    <tr>
                        <th scope="col">@T("m.act")</th>
                        <th scope="col">@T("m.zone")</th>
                        <th scope="col">@T("m.status")</th>
                        <th scope="col">@T("chart.time")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var act in Model.Actuators)
                    {
                        var isOn = act.CurrentStatus == "ON";
                        <tr>
                            <th scope="row">@RuleDisplay.Device(lang, act.Name)<span class="sim">@T("m.simulated")</span></th>
                            <td>@RuleDisplay.ZoneName(lang, act.Zone?.Name ?? "")</td>
                            <td>
                                <span class="st @(isOn ? "" : "mute")">
                                    @await Html.Icon(isOn ? "check" : "power", 14)
                                    @T(isOn ? "m.on" : "m.off")
                                </span>
                            </td>
                            <td class="sub">@string.Format(T("au.act.last"), act.LastTriggered.ToString("HH:mm"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="note">@T(ControlAccess.ForActuators(User).ReasonKey ?? "card.modelled")</p>
    </section>
</div>
