@model AgriSyncIndia.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Executive Climate Dashboard";
}

<div class="row mb-3">
    <!-- Header Bar: Farm Selector, Indian Crop Preset, Weather Banner & Language Toggle -->
    <div class="col-12">
        <div class="card card-agri border-0 shadow-sm overflow-hidden">
            <div class="bg-light p-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-3">
                
                <!-- Farm Selector Dropdown & Add Cluster Button -->
                <div class="d-flex align-items-center gap-2">
                    <span class="text-secondary small fw-semibold text-uppercase"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Farm Cluster:</span>
                    <form method="get" asp-controller="Climate" asp-action="Dashboard" id="farmSelectorForm" class="m-0">
                        <input type="hidden" name="cropPreset" value="@Model.SelectedCropPreset" />
                        <input type="hidden" name="lang" value="@Model.CurrentLanguage" />
                        <select name="farm" class="form-select form-select-sm fw-bold border-success" onchange="this.form.submit()">
                            @foreach (var farm in Model.AvailableFarms)
                            {
                                <option value="@farm" selected="@(farm == Model.SelectedFarm ? "selected" : null)">@farm</option>
                            }
                        </select>
                    </form>
                    <a asp-controller="FarmCluster" asp-action="Create" class="btn btn-sm btn-outline-success px-2 py-1" title="Add a new farm cluster to this list">
                        <i class="bi bi-plus-lg me-1"></i>Add Cluster
                    </a>
                </div>

                <!-- Indian Crop Preset Selector -->
                <div class="d-flex align-items-center gap-2">
                    <span class="text-secondary small fw-semibold text-uppercase"><i class="bi bi-seedling text-success me-1"></i>Crop Protocol:</span>
                    <form method="get" asp-controller="Climate" asp-action="Dashboard" id="cropSelectorForm" class="m-0">
                        <input type="hidden" name="farm" value="@Model.SelectedFarm" />
                        <input type="hidden" name="lang" value="@Model.CurrentLanguage" />
                        <select name="cropPreset" class="form-select form-select-sm fw-semibold bg-success bg-opacity-10 border-success" onchange="this.form.submit()">
                            @foreach (var crop in Model.CropPresets)
                            {
                                <option value="@crop" selected="@(crop.Contains(Model.SelectedCropPreset) ? "selected" : null)">@crop</option>
                            }
                        </select>
                    </form>
                </div>

                <!-- Language Toggle & Refresh Button -->
                <div class="d-flex align-items-center gap-2">
                    <!-- Language Toggle (en, hi, pa) -->
                    <div class="btn-group btn-group-sm" role="group" aria-label="Language Selector">
                        <a asp-action="Dashboard" asp-route-farm="@Model.SelectedFarm" asp-route-cropPreset="@Model.SelectedCropPreset" asp-route-lang="en" 
                           class="btn @(Model.CurrentLanguage == "en" ? "btn-success" : "btn-outline-secondary")">English</a>
                        <a asp-action="Dashboard" asp-route-farm="@Model.SelectedFarm" asp-route-cropPreset="@Model.SelectedCropPreset" asp-route-lang="hi" 
                           class="btn @(Model.CurrentLanguage == "hi" ? "btn-success" : "btn-outline-secondary")">हिंदी</a>
                        <a asp-action="Dashboard" asp-route-farm="@Model.SelectedFarm" asp-route-cropPreset="@Model.SelectedCropPreset" asp-route-lang="pa" 
                           class="btn @(Model.CurrentLanguage == "pa" ? "btn-success" : "btn-outline-secondary")">ਪੰਜਾਬੀ</a>
                    </div>

                    <!-- Open-Meteo REST Sync Button -->
                    <form asp-controller="Climate" asp-action="RefreshTelemetry" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="btn btn-sm btn-outline-success d-flex align-items-center shadow-sm" title="Fetch fresh weather from Open-Meteo REST API">
                            <i class="bi bi-arrow-repeat me-1"></i> Sync Telemetry
                        </button>
                    </form>
                </div>
            </div>

            <!-- Live IST Weather Banner -->
            <div class="p-3 bg-white d-flex flex-wrap align-items-center justify-content-between border-start border-4 border-success">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                        <i class="bi bi-broadcast me-1"></i> Open-Meteo REST Ingestion
                    </span>
                    <span class="fw-medium text-dark small">@Model.WeatherBannerText</span>
                </div>
                <div class="d-flex align-items-center gap-3 text-muted small mt-2 mt-md-0">
                    <span><i class="bi bi-clock-history me-1"></i> @Model.LiveIstTimestamp</span>
                    @if (Model.ActiveAlertsCount > 0)
                    {
                        <a asp-controller="Alerts" asp-action="Index" class="badge bg-danger text-white text-decoration-none">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @Model.ActiveAlertsCount Active Risk Alerts
                        </a>
                    }
                    else
                    {
                        <span class="badge bg-success bg-opacity-75 text-white">
                            <i class="bi bi-shield-check me-1"></i> All Zones Normal
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SECTION 1: 4 PRIMARY METRIC CARDS (BOOTSTRAP CARDS) -->
<div class="row g-3 mb-4">
    <!-- Card 1: Ambient / Nursery Temp -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-agri h-100 p-3 border-0 border-top border-4 border-danger">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="text-uppercase text-muted fw-bold small">Ambient Temperature</span>
                    <h2 class="display-6 fw-bold mb-0 text-dark">@Model.PrimaryTemp<small class="fs-5 text-muted">°C</small></h2>
                </div>
                <div class="p-2 bg-danger bg-opacity-10 text-danger rounded-3">
                    <i class="bi bi-thermometer-half fs-3"></i>
                </div>
            </div>
            <div class="d-flex align-items-center justify-content-between text-muted small pt-2 border-top mt-auto">
                <span>Target: 24.5°C</span>
                <span class="text-danger fw-semibold"><i class="bi bi-arrow-up"></i> +1.8°C Offset</span>
            </div>
        </div>
    </div>

    <!-- Card 2: Relative Humidity -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-agri h-100 p-3 border-0 border-top border-4 border-info">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="text-uppercase text-muted fw-bold small">Relative Humidity</span>
                    <h2 class="display-6 fw-bold mb-0 text-dark">@Model.PrimaryHumidity<small class="fs-5 text-muted">%</small></h2>
                </div>
                <div class="p-2 bg-info bg-opacity-10 text-info rounded-3">
                    <i class="bi bi-moisture fs-3"></i>
                </div>
            </div>
            <div class="d-flex align-items-center justify-content-between text-muted small pt-2 border-top mt-auto">
                <span>Polyhouse Target: 75%</span>
                <span class="text-success fw-semibold"><i class="bi bi-check2"></i> Controlled Range</span>
            </div>
        </div>
    </div>

    <!-- Card 3: Vapor Pressure Deficit (VPD in kPa) with Optimal Transpiration badge -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-agri h-100 p-3 border-0 border-top border-4 border-success">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <div class="d-flex align-items-center gap-1 mb-1">
                        <span class="text-uppercase text-muted fw-bold small">VPD Deficit</span>
                        <span class="badge @Model.VpdBadgeCssClass" style="font-size: 0.72rem;">@Model.VpdBadgeText</span>
                    </div>
                    <h2 class="display-6 fw-bold mb-0 text-dark">@Model.PrimaryVPD<small class="fs-5 text-muted"> kPa</small></h2>
                </div>
                <div class="p-2 bg-success bg-opacity-10 text-success rounded-3">
                    <i class="bi bi-wind fs-3"></i>
                </div>
            </div>
            <div class="text-muted small pt-2 border-top mt-auto">
                <span class="text-truncate d-block" title="@Model.VpdDescription">
                    <i class="bi bi-info-circle text-success me-1"></i> @Model.VpdDescription
                </span>
            </div>
        </div>
    </div>

    <!-- Card 4: Solar Radiation & Surface Pressure -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-agri h-100 p-3 border-0 border-top border-4 border-warning">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="text-uppercase text-muted fw-bold small">Solar Radiation</span>
                    <h2 class="display-6 fw-bold mb-0 text-dark">@Model.SolarRadiation<small class="fs-5 text-muted"> W/m²</small></h2>
                </div>
                <div class="p-2 bg-warning bg-opacity-10 text-warning rounded-3">
                    <i class="bi bi-sun fs-3"></i>
                </div>
            </div>
            <div class="d-flex align-items-center justify-content-between text-muted small pt-2 border-top mt-auto">
                <span>Pressure: @Model.SurfacePressure hPa</span>
                <span>Wind: @Model.AmbientWindSpeed km/h</span>
            </div>
        </div>
    </div>
</div>

<!-- SECTION 2: MIDDLE SECTION (3 MICROCLIMATE ZONES & ACTUATOR OVERRIDES) -->
<div class="row g-4 mb-4">
    <!-- Discrete Microclimate Zones: 3 Bootstrap Cards -->
    <div class="col-12 col-lg-7">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-bold m-0 text-dark"><i class="bi bi-grid-3x3-gap-fill text-success me-2"></i>Discrete Microclimate Sectors</h5>
            <span class="badge bg-secondary bg-opacity-10 text-dark">3 Configured Zones</span>
        </div>

        <div class="row g-3">
            @foreach (var zone in Model.ZoneCards)
            {
                <div class="col-12">
                    <div class="card card-agri p-3 border-0 border-start border-4 @(zone.Status == "Optimal" ? "border-success" : (zone.Status == "Caution" ? "border-warning" : "border-danger"))">
                        <div class="d-flex flex-wrap align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="p-2 bg-light rounded-circle text-success"><i class="bi @zone.IconClass fs-5"></i></span>
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark">@zone.Name</h6>
                                    <span class="text-muted small"><i class="bi bi-tag me-1"></i>@zone.CropType</span>
                                </div>
                            </div>
                            <div>
                                <span class="badge @(zone.Status == "Optimal" ? "bg-success" : (zone.Status == "Caution" ? "bg-warning text-dark" : "bg-danger")) px-2 py-1">
                                    @zone.Status
                                </span>
                            </div>
                        </div>

                        <div class="row g-2 py-2 border-top border-bottom text-center my-2 bg-light bg-opacity-50 rounded">
                            <div class="col-3 border-end">
                                <div class="text-muted small">Current Temp</div>
                                <div class="fw-bold text-dark fs-6">@zone.CurrentTemp°C</div>
                                <div class="text-muted" style="font-size: 0.72rem;">Target: @zone.TargetTemp°C</div>
                            </div>
                            <div class="col-3 border-end">
                                <div class="text-muted small">Humidity</div>
                                <div class="fw-bold text-dark fs-6">@zone.CurrentHumidity%</div>
                                <div class="text-muted" style="font-size: 0.72rem;">Target: @zone.TargetHumidity%</div>
                            </div>
                            <div class="col-3 border-end">
                                <div class="text-muted small">VPD Deficit</div>
                                <div class="fw-bold text-dark fs-6">@zone.CurrentVPD <small class="text-muted">kPa</small></div>
                                <div class="text-success" style="font-size: 0.72rem;">Optimal Range</div>
                            </div>
                            <div class="col-3">
                                <div class="text-muted small">Soil Moisture</div>
                                <div class="fw-bold text-dark fs-6">@zone.CurrentSoilMoisture%</div>
                                <div class="text-muted" style="font-size: 0.72rem;">Root Zone VWC</div>
                            </div>
                        </div>

                        <div class="text-muted small mt-1">
                            <i class="bi bi-info-circle me-1"></i> @zone.Description
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Actuator Overrides: ASP.NET Core Form with Toggle Buttons -->
    <div class="col-12 col-lg-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-bold m-0 text-dark"><i class="bi bi-toggle-on text-primary me-2"></i>Actuator Overrides & Control</h5>
            <span class="badge bg-primary bg-opacity-10 text-primary">Automated & Manual Override</span>
        </div>

        <div class="card card-agri p-3 border-0">
            <p class="text-muted small mb-3">
                Direct hardware bypass for smart farm equipment. In Auto Mode, states are regulated by the IF-THEN rules engine.
            </p>

            <div class="list-group list-group-flush gap-2">
                @foreach (var actuator in Model.Actuators)
                {
                    <div class="list-group-item p-3 rounded border d-flex flex-wrap align-items-center justify-content-between gap-2 @(actuator.CurrentStatus == "ON" ? "bg-success bg-opacity-10 border-success" : "bg-light border-light")">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="fw-bold text-dark">@actuator.Name</span>
                                @if (actuator.CurrentStatus == "ON")
                                {
                                    <span class="badge bg-success">ACTIVE (ON)</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">STANDBY (OFF)</span>
                                }
                            </div>
                            <div class="text-muted small">
                                <span><i class="bi bi-geo-alt me-1"></i>@actuator.ZoneName</span> • 
                                <span><i class="bi bi-lightning-charge me-1"></i>@actuator.PowerRatingKw kW</span> • 
                                <span>Auto: @(actuator.IsAutoMode ? "Enabled" : "Manual")</span>
                            </div>
                            <div class="text-secondary" style="font-size: 0.75rem;">
                                Last triggered: @actuator.LastTriggered.ToString("HH:mm:ss") IST
                            </div>
                        </div>

                        <!-- Toggle Button Form -->
                        <form asp-controller="Climate" asp-action="ToggleActuator" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="actuatorId" value="@actuator.ActuatorId" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="btn btn-sm @(actuator.CurrentStatus == "ON" ? "btn-danger" : "btn-success") px-3 fw-semibold shadow-sm">
                                <i class="bi @(actuator.CurrentStatus == "ON" ? "bi-power" : "bi-play-circle") me-1"></i>
                                @(actuator.CurrentStatus == "ON" ? "Turn OFF" : "Turn ON")
                            </button>
                        </form>
                    </div>
                }
            </div>

            <div class="mt-3 p-2 bg-light rounded text-center small text-muted border">
                <i class="bi bi-cpu text-success me-1"></i> Actuators respond to telemetry updates in under 200ms.
            </div>
        </div>
    </div>
</div>

<!-- SECTION 3: BOTTOM SECTION (24-HOUR DIURNAL TELEMETRY GRAPH VIA CHART.JS) -->
<div class="row">
    <div class="col-12">
        <div class="card card-agri p-4 border-0 shadow-sm">
            <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
                <div>
                    <h5 class="fw-bold mb-1 text-dark">
                        <i class="bi bi-graph-up text-success me-2"></i>24-Hour Diurnal Telemetry Graph
                    </h5>
                    <p class="text-muted small mb-0">
                        Synchronized hourly microclimate telemetry across Polyhouse Nursery, Open Field, and Drip Sector in Indian Standard Time (IST).
                    </p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Polyhouse Temp (°C)</span>
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">Open Field (°C)</span>
                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">Drip Sector (°C)</span>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">VPD (kPa)</span>
                </div>
            </div>

            <!-- HTML5 Canvas for Chart.js -->
            <div style="position: relative; height: 380px; width: 100%;">
                <canvas id="diurnalChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('diurnalChart').getContext('2d');

            // Data serialized from Razor Model
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData.Labels));
            const polyTemps = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData.PolyhouseTemp));
            const openTemps = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData.OpenFieldTemp));
            const dripTemps = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData.DripSectorTemp));
            const polyVPD = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData.PolyhouseVPD));
            const polyRH = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData.PolyhouseHumidity));

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Polyhouse Nursery Temp (°C)',
                            data: polyTemps,
                            borderColor: '#dc2626',
                            backgroundColor: 'rgba(220, 38, 38, 0.08)',
                            tension: 0.35,
                            fill: true,
                            yAxisID: 'yTemp',
                            borderWidth: 2.5,
                            pointRadius: 2.5
                        },
                        {
                            label: 'Open Field Ambient (°C)',
                            data: openTemps,
                            borderColor: '#f59e0b',
                            backgroundColor: 'transparent',
                            borderDash: [5, 4],
                            tension: 0.35,
                            yAxisID: 'yTemp',
                            borderWidth: 2,
                            pointRadius: 2
                        },
                        {
                            label: 'Drip Sector Canopy (°C)',
                            data: dripTemps,
                            borderColor: '#0284c7',
                            backgroundColor: 'transparent',
                            tension: 0.35,
                            yAxisID: 'yTemp',
                            borderWidth: 2,
                            pointRadius: 2
                        },
                        {
                            label: 'Vapor Pressure Deficit (kPa)',
                            data: polyVPD,
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.08)',
                            tension: 0.35,
                            yAxisID: 'yVpd',
                            borderWidth: 2,
                            pointRadius: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                font: {
                                    family: "'Plus Jakarta Sans', sans-serif",
                                    weight: 600
                                },
                                usePointStyle: true,
                                padding: 15
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(17, 24, 39, 0.92)',
                            padding: 12,
                            titleFont: { size: 13, weight: 'bold' },
                            bodyFont: { size: 12 },
                            cornerRadius: 8
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: '#f3f4f6' },
                            ticks: {
                                maxRotation: 45,
                                minRotation: 0,
                                font: { size: 11 }
                            }
                        },
                        yTemp: {
                            type: 'linear',
                            position: 'left',
                            title: {
                                display: true,
                                text: 'Temperature (°C)',
                                color: '#374151',
                                font: { weight: 600 }
                            },
                            suggestedMin: 15,
                            suggestedMax: 38,
                            grid: { color: '#e5e7eb' }
                        },
                        yVpd: {
                            type: 'linear',
                            position: 'right',
                            title: {
                                display: true,
                                text: 'VPD (kPa)',
                                color: '#10b981',
                                font: { weight: 600 }
                            },
                            suggestedMin: 0.2,
                            suggestedMax: 2.0,
                            grid: { drawOnChartArea: false }
                        }
                    }
                }
            });
        });
    </script>
}
