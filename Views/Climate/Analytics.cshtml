@model HistoryViewModel
@using System.Text.Json
@{
    var lang = Model.CurrentLanguage;
    string T(string k) => Localizer.T(lang, k);
    ViewData["Title"] = T("h.title");
    var json = JsonSerializer.Serialize(new
    {
        selected = Model.Selected,
        labels = Model.Chart.Labels,
        series = Model.Chart.Series.Select(s => new { key = s.Key, name = s.Name, temp = s.Temp, vpd = s.Vpd }),
        band = new[] { ClimateRules.VpdVegetativeMax, ClimateRules.VpdOptimalMax },
        text = new { band = T("chart.band"), time = T("chart.time") }
    }, new JsonSerializerOptions(JsonSerializerDefaults.Web));
    var statViews = new (string Icon, string Title, Stat? S, int Dec, string Unit)[]
    {
        ("thermometer", T("m.temp"), Model.Temp, 1, "°C"),
        ("droplet", T("m.hum"), Model.Humidity, 1, "%"),
        ("wind", T("m.vpd"), Model.Vpd, 2, "kPa")
    };
}
@section Head { <link rel="stylesheet" href="~/css/pages-a.css" asp-append-version="true" /> }

<div class="dh">
    <div class="dt">
        <h1 class="sec-title">@T("h.title")</h1>
        <p class="sub">@T("h.sub")</p>
    </div>
    <div class="dact">
        <div class="seg" role="group" aria-label="@T("h.range")">
            <a asp-action="Analytics" asp-route-range="24h" asp-route-zoneId="@Model.SelectedZoneId" aria-current="@(Model.Range == "24h" ? "true" : null)">@T("h.r24")</a>
            <a asp-action="Analytics" asp-route-range="7d" asp-route-zoneId="@Model.SelectedZoneId" aria-current="@(Model.Range == "7d" ? "true" : null)">@T("h.r7")</a>
        </div>
        <form method="get" asp-action="Analytics" class="farmsel">
            <input type="hidden" name="range" value="@Model.Range" />
            <label class="sr-only" for="zoneId">@T("h.zone")</label>
            <select id="zoneId" name="zoneId">
                <option value="" selected="@(Model.SelectedZoneId == null)">@T("h.allzones")</option>
                @foreach (var z in Model.Zones) { <option value="@z.Id" selected="@(z.Id == Model.SelectedZoneId)">@z.Name</option> }
            </select>
            <button type="submit" class="btn sec sm">@T("h.show")</button>
        </form>
        <a class="btn sec sm" asp-action="ExportCsv" asp-route-range="@Model.Range" asp-route-zoneId="@Model.SelectedZoneId">@await Html.Icon("download", 14)@T("h.csv")</a>
    </div>
</div>

@if (Model.SampleCount == 0)
{
    <div class="card c12 bento-gap"><p class="empty">@T("h.empty")</p></div>
}
else
{
    <div class="bento">
        @foreach (var s in statViews)
        {
            <section class="card c4" aria-label="@s.Title">
                <div class="ch">@await Html.Icon(s.Icon)<span>@s.Title</span><span class="sp">@s.Unit</span></div>
                <dl class="sdl">
                    <div><dt>@T("h.min")</dt><dd>@ViewFormat.N(s.S?.Min, s.Dec)</dd></div>
                    <div class="mid"><dt>@T("h.avg")</dt><dd>@ViewFormat.N(s.S?.Avg, s.Dec)</dd></div>
                    <div><dt>@T("h.max")</dt><dd>@ViewFormat.N(s.S?.Max, s.Dec)</dd></div>
                </dl>
            </section>
        }
        <section class="card c12"><partial name="_AChart" model="Model" view-data='new ViewDataDictionary(ViewData) { { "kind", "temp" } }' /></section>
        <section class="card c12"><partial name="_AChart" model="Model" view-data='new ViewDataDictionary(ViewData) { { "kind", "vpd" } }' /></section>
    </div>
    <p class="note">@string.Format(T("h.samples"), Model.SampleCount) · @T("card.modelled")</p>
    <script type="application/json" id="chart-data">@Html.Raw(json)</script>
}

@section Scripts {
    <script src="~/lib/chart.umd.min.js"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
    <script src="~/js/history.js" asp-append-version="true"></script>
}
