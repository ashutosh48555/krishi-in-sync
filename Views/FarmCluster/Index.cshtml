@model AgriSyncIndia.ViewModels.FarmClusterListViewModel
@{
    ViewData["Title"] = "Farm Clusters - AgriSync India";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card card-agri p-4 border-0">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <h4 class="fw-bold mb-1 text-dark">
                        <i class="bi bi-geo-alt-fill text-success me-2"></i>Registered Farm Clusters & Research Sites
                    </h4>
                    <p class="text-muted small mb-0">
                        Geo-spatial agricultural blocks connected to AgriSync automated climate telemetry.
                    </p>
                </div>
                <div>
                    <a asp-controller="FarmCluster" asp-action="Create" class="btn btn-success d-flex align-items-center shadow-sm">
                        <i class="bi bi-plus-circle me-2"></i>
                        <span>Add New Farm Cluster</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    @foreach (var cluster in Model.Clusters)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card card-agri h-100 p-4 border-0 border-top border-4 border-success d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                        <i class="bi bi-pin-map-fill me-1"></i>@cluster.Region
                    </span>
                    <span class="badge bg-light text-dark border">
                        @cluster.TotalAcreage Acres
                    </span>
                </div>

                <h5 class="fw-bold text-dark mt-2 mb-1">@cluster.Name</h5>
                <div class="text-muted small mb-2">
                    <i class="bi bi-compass me-1"></i>GPS: @cluster.Latitude.ToString("F4")°N, @cluster.Longitude.ToString("F4")°E
                </div>

                <div class="p-2 bg-light rounded text-dark small mb-3 border">
                    <span class="text-muted d-block small">Primary Crops:</span>
                    <strong>@cluster.PrimaryCrops</strong>
                </div>

                <p class="text-muted small flex-grow-1 mb-3">
                    @cluster.Description
                </p>

                <div class="pt-3 border-top d-flex justify-content-between align-items-center mt-auto">
                    <span class="badge bg-success"><i class="bi bi-broadcast me-1"></i>Live Telemetry</span>
                    <a asp-controller="Climate" asp-action="Dashboard" asp-route-farm="@cluster.Name" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-speedometer2 me-1"></i> View Dashboard
                    </a>
                </div>
            </div>
        </div>
    }
</div>
