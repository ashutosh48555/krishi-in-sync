@model AgriSyncIndia.ViewModels.CreateFarmClusterViewModel
@{
    var lang = Context.Lang();
    string T(string k) => Localizer.T(lang, k);
    ViewData["Title"] = T("cl.create.title");
}
@section Head { <link rel="stylesheet" href="~/css/pages-b.css" asp-append-version="true" /> }

<div class="dh">
    <div class="dt">
        <h1 class="sec-title">@T("cl.create.title")</h1>
        <p class="sub">@T("cl.create.sub")</p>
    </div>
</div>

<div class="card form-card">
    <form asp-action="Create" method="post" class="form-grid">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="notice form-err-box">
                @await Html.Icon("triangle-alert")
                <div>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@FormText.Error(lang, error.ErrorMessage)</div>
                    }
                </div>
            </div>
        }

        <div class="fg">
            <label class="fl" asp-for="Name">@T("cl.f.name")</label>
            <input asp-for="Name" class="inp" placeholder="e.g. Karnal Research Farm" required />
            <span asp-validation-for="Name" class="err"></span>
        </div>

        <div class="fg">
            <label class="fl" asp-for="Region">@T("cl.f.region")</label>
            <input asp-for="Region" class="inp" placeholder="e.g. Haryana" required />
            <span asp-validation-for="Region" class="err"></span>
        </div>

        <div class="frow">
            <div class="fg fg-1">
                <label class="fl" asp-for="Latitude">@T("cl.f.lat")</label>
                <input asp-for="Latitude" type="number" step="any" id="f-lat" class="inp" placeholder="28.6139" />
            </div>
            <div class="fg fg-1">
                <label class="fl" asp-for="Longitude">@T("cl.f.lon")</label>
                <input asp-for="Longitude" type="number" step="any" id="f-lon" class="inp" placeholder="77.2090" />
            </div>
        </div>
        <p class="sub hint-sub">@T("cl.f.hint")</p>

        <div class="presets-row">
            <span class="sub preset-label">Presets:</span>
            <button type="button" class="btn-preset" data-lat="28.6139" data-lon="77.2090">Delhi</button>
            <button type="button" class="btn-preset" data-lat="30.9010" data-lon="75.8573">Ludhiana</button>
            <button type="button" class="btn-preset" data-lat="29.6857" data-lon="76.9905">Karnal</button>
            <button type="button" class="btn-preset" data-lat="21.1458" data-lon="79.0882">Nagpur</button>
            <button type="button" class="btn-preset" data-lat="22.5645" data-lon="72.9289">Anand</button>
        </div>

        <div class="frow mt-12">
            <div class="fg fg-1">
                <label class="fl" asp-for="TotalAcreage">@T("cl.f.acres")</label>
                <input asp-for="TotalAcreage" type="number" step="any" class="inp" placeholder="25" required />
            </div>
            <div class="fg fg-2">
                <label class="fl" asp-for="PrimaryCrops">@T("cl.f.crops")</label>
                <input asp-for="PrimaryCrops" class="inp" placeholder="@T("cl.f.cropsph")" required />
            </div>
        </div>

        <div class="cta mt-20">
            <button type="submit" class="btn">@await Html.Icon("check", 14)@T("cl.f.submit")</button>
            <a asp-action="Index" class="btn sec">@T("cl.f.cancel")</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/cluster.js" asp-append-version="true"></script>
}
