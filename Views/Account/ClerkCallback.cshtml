@using AgriSyncIndia.Services
@{
    ViewData["Title"] = Context.T("login.title");
    var clerk = (ClerkOptions)ViewData["Clerk"]!;
    var signOut = ViewData["SignOut"] is true;
}
<section class="auth center">
    <div id="clerk-root"
         data-signout="@(signOut ? "1" : "0")"
         data-return-url="@ViewData["ReturnUrl"]"
         data-session-url="@Url.Action("ClerkSession", "Account")"
         data-login-url="@Url.Action("Login", "Account")"
         data-default-url="@Url.Action("Dashboard", "Climate")">
        @Html.AntiForgeryToken()
        <p id="clerk-status" class="sub" role="status">@Context.T(signOut ? "clerk.out" : "clerk.in")</p>
        <a id="clerk-fallback" class="btn sec" href="@Url.Action("Login", "Account")" hidden>@Context.T("clerk.back")</a>
    </div>
</section>

@section Scripts {
    <script defer crossorigin="anonymous" src="@clerk.Issuer/npm/@@clerk/ui@@1/dist/ui.browser.js"></script>
    <script defer crossorigin="anonymous" data-clerk-publishable-key="@clerk.PublishableKey"
            src="@clerk.Issuer/npm/@@clerk/clerk-js@@6/dist/clerk.browser.js"></script>
    <script defer src="~/js/clerk-callback.js" asp-append-version="true"></script>
}
