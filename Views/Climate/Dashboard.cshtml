@model DashboardViewModel
@inject NeonOptions Neon
@{
    var lang = Model.CurrentLanguage;
    string T(string k) => Localizer.T(lang, k);
    ViewData["Title"] = T("dash.title");    ViewData["selected"] = (Model.ZoneCards.FirstOrDefault(c => c.Key == "poly") ?? Model.ZoneCards.FirstOrDefault())?.Key;
    var chip = Model.AmbientTemp is double t && Model.AmbientHumidity is double h
        ? string.Format(T(Model.AmbientIsStale ? "chip.stale" : "chip.live"), Model.Place, ViewFormat.N(t), ViewFormat.N(h, 0), ViewFormat.N(Model.AmbientVpd, 2))
        : T("chip.none");
}
@section Head {
    @if (Neon.RealtimeEnabled)
    {
        <meta name="neon-telemetry-url" content="@Neon.TelemetryUrl" />
        <meta name="neon-realtime-url" content="@Neon.RealtimeUrl" />
    }
}

<div class="dh">
    <div class="dt">
        <h1 class="sec-title">@T("dash.title")</h1>
        <p class="sub">@Model.SelectedFarm@(Model.SelectedRegion.Length > 0 ? " · " + Model.SelectedRegion : "")</p>
    </div>
    <div class="dact">
        @if (Model.AvailableFarms.Count > 1)
        {
            <form method="get" class="farmsel">
                <label class="sr-only" for="farm">@T("dash.farm")</label>
                <select id="farm" name="farm">
                    @foreach (var f in Model.AvailableFarms) { <option value="@f" selected="@(f == Model.SelectedFarm)">@f</option> }
                </select>
                <button type="submit" class="btn sec sm">@T("dash.apply")</button>
            </form>
        }
        <span class="chip nm"><span class="dot @(Model.AmbientTemp == null || Model.AmbientIsStale ? "off" : null)"></span><span>@chip</span></span>
        <span class="chip nm">@(Model.UpdatedAt.Length > 0 ? string.Format(T("dash.updated"), Model.UpdatedAt) : T("dash.noupdate"))</span>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Climate" asp-action="RefreshTelemetry" method="post">
                <input type="hidden" name="returnUrl" value="@Url.Action("Dashboard", "Climate")" />
                <button type="submit" class="btn sm">@await Html.Icon("refresh-cw", 14)@T("dash.refresh")</button>
            </form>
        }
        else
        {
            <a class="btn sec sm" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Dashboard", "Climate")">@await Html.Icon("user", 14)@T("dash.signinrefresh")</a>
        }
    </div>
</div>

@if (Model.AmbientIsStale)
{
    <p class="notice" role="status">@await Html.Icon("triangle-alert", 16)<span>@string.Format(T("dash.stale"), Model.AmbientAsOf)</span></p>
}

@if (Model.ZoneCards.Count == 0)
{
    <div class="card c12"><p class="empty">@T("dash.empty")</p></div>
}
else
{
    <div class="bento">
        <section class="card c12"><partial name="_HeadlineCard" model="Model" /></section>
        <section class="card c12" aria-labelledby="zones-h">
            <div class="ch">@await Html.Icon("list")<span id="zones-h">@T("card.zones")</span><span class="sp">@T("card.modelled")</span><span id="live-badge" class="chip nm" data-state="connecting">Connecting</span></div>
            <partial name="_ZonesTable" model="Model" />
        </section>
        <section class="card c8"><partial name="_ChartCard" model="Model" view-data='new ViewDataDictionary(ViewData) { { "kind", "temp" } }' /></section>
        <section class="card c4 r2"><partial name="_AlertsCard" model="Model" /></section>
        <section class="card c8"><partial name="_ChartCard" model="Model" view-data='new ViewDataDictionary(ViewData) { { "kind", "vpd" } }' /></section>
    </div>
    <partial name="_ChartData" model="Model" />
}

@section Scripts {
    <script src="~/lib/chart.umd.min.js"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
    @if (Neon.RealtimeEnabled)
    {
        <script type="module" src="~/js/live-zones.js" asp-append-version="true"></script>
    }
}
