@model AgriSyncIndia.ViewModels.FarmClusterListViewModel
@{
    var lang = Context.Lang();
    string T(string k) => Localizer.T(lang, k);
    ViewData["Title"] = T("cl.title");
}
@section Head { <link rel="stylesheet" href="~/css/pages-b.css" asp-append-version="true" /> }

<div class="dh">
    <div class="dt">
        <h1 class="sec-title">@T("cl.title")</h1>
        <p class="sub">@T("cl.sub")</p>
    </div>
    <div class="dact">
        <a asp-action="Create" class="btn sm">@await Html.Icon("plus", 14)@T("cl.add")</a>
    </div>
</div>

<section class="card c12" aria-labelledby="clusters-h">
    <div class="ch">
        @await Html.Icon("layout-grid")
        <span id="clusters-h">@T("cl.title")</span>
        <span class="sp">@Model.Clusters.Count</span>
    </div>

    @if (Model.Clusters.Count == 0)
    {
        <p class="empty">@T("cl.empty")</p>
    }
    else
    {
        <div class="tscroll" tabindex="0" role="region" aria-label="@T("cl.title")">
            <table class="ttab">
                <caption class="sr-only">@T("cl.title")</caption>
                <thead>
                    <tr>
                        <th scope="col">@T("cl.f.name")</th>
                        <th scope="col">@T("cl.f.region")</th>
                        <th scope="col">@T("cl.f.acres")</th>
                        <th scope="col">@T("cl.coords")</th>
                        <th scope="col">@T("cl.crops")</th>
                        <th scope="col" class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Clusters)
                    {
                        <tr>
                            <th scope="row"><b>@c.Name</b></th>
                            <td>@c.Region</td>
                            <td class="n">@string.Format(T("cl.acres"), ViewFormat.N(c.TotalAcreage, 1))</td>
                            <td class="sub n">@c.Latitude.ToString("0.0000")°N, @c.Longitude.ToString("0.0000")°E</td>
                            <td>@c.PrimaryCrops</td>
                            <td class="text-end">
                                <a asp-controller="Climate" asp-action="Dashboard" asp-route-farm="@c.Name" class="btn sec sm">
                                    @await Html.Icon("arrow-right", 14)@T("cl.open")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
<p class="note">@T("cl.zonesnote")</p>
