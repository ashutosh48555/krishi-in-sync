@{
    var lang = Context.Lang();
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <title>@(string.IsNullOrEmpty(title) ? "Krishi Sync" : title + " · Krishi Sync")</title>
    <script src="~/js/theme-init.js"></script>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hero3d.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-switch.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip" href="#main">@Context.T("skip")</a>
    <div class="wrap">
        <partial name="_Nav" />
        @if (TempData["SuccessMessage"] is string ok)
        {
            <div class="toast" role="status" data-toast>
                @await Html.Icon("check", 16)<span>@ok</span>
                <button type="button" class="toast-close" data-close-toast aria-label="Dismiss">@await Html.Icon("x", 14)</button>
                <div class="toast-progress"></div>
            </div>
        }
        @if (TempData["ErrorMessage"] is string bad)
        {
            <div class="toast bad" role="alert" data-toast>
                @await Html.Icon("triangle-alert", 16)<span>@bad</span>
                <button type="button" class="toast-close" data-close-toast aria-label="Dismiss">@await Html.Icon("x", 14)</button>
                <div class="toast-progress"></div>
            </div>
        }
        <main id="main">
            @RenderBody()
        </main>
        <footer>
            <span>@Context.T("foot.text")</span>
            <div class="foot-links">
                <a href="/swagger" target="_blank" rel="noopener">@await Html.Icon("cpu", 14)<span>API (Swagger)</span></a>
                <a asp-controller="Home" asp-action="Privacy">@Context.T("foot.privacy")</a>
            </div>
        </footer>
    </div>
    <partial name="_VpdModal" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
