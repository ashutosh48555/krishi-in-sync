@model LoginViewModel
@{
    string T(string k) => Context.T(k);
    ViewData["Title"] = T("login.title");
    var demo = ViewData["Demo"] is true;
    const string demoEmail = "dr.sharma@agrisync.in", demoPass = "AgriSync@123";
}
<section class="auth" aria-labelledby="auth-h">
    <h1 class="sec-title" id="auth-h">@T("login.title")</h1>
    <p class="sub">@T("login.sub")</p>

    @if (ViewData["ClerkEnabled"] is true)
    {
        <a asp-controller="Account" asp-action="ClerkCallback" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="btn full">@await Html.Icon("user", 16)@T("login.clerk")</a>
        <p class="divider"><span>@T("login.or")</span></p>
    }

    <form asp-controller="Account" asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="err form-err" role="alert"></div>
        <div class="field">
            <label for="Email">@T("login.email")</label>
            <input id="Email" name="Email" type="email" required autocomplete="username" value="@(demo ? demoEmail : Model.Email)" aria-describedby="Email-err" />
            <span asp-validation-for="Email" class="err" id="Email-err"></span>
        </div>
        <div class="field">
            <label for="Password">@T("login.password")</label>
            <input id="Password" name="Password" type="password" required autocomplete="current-password" value="@(demo ? demoPass : null)" aria-describedby="Password-err" />
            <span asp-validation-for="Password" class="err" id="Password-err"></span>
        </div>
        <label class="check"><input asp-for="RememberMe" type="checkbox" />@T("login.remember")</label>
        <button type="submit" class="btn full">@T("login.submit")</button>
    </form>
    <p class="note demo-note">@Context.T("login.demo", demoEmail, demoPass)</p>
</section>
