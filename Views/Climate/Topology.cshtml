@model TopologyViewModel
@{
    var lang = Model.CurrentLanguage;
    string T(string k) => Localizer.T(lang, k);
    ViewData["Title"] = T("z.title");
    var cardData = new ViewDataDictionary(ViewData) { { "lang", lang }, { "canToggle", Model.CanToggle } };
}
@section Head { <link rel="stylesheet" href="~/css/pages-a.css" asp-append-version="true" /> }

<div class="dh">
    <div class="dt">
        <h1 class="sec-title">@T("z.title")</h1>
        <p class="sub">@T("z.sub")</p>
    </div>
</div>

@if (Model.Zones.Count == 0)
{
    <div class="card c12"><p class="empty">@T("dash.empty")</p></div>
}
else
{
    <div class="bento">
        @foreach (var z in Model.Zones)
        {
            <div class="c4 zcol"><partial name="_AZoneCard" model="z" view-data="cardData" /></div>
        }
        <section class="card c12" aria-labelledby="topo-h">
            <div class="ch">@await Html.Icon("layout-grid")<span id="topo-h">@T("z.list")</span></div>
            <div class="tscroll" tabindex="0" role="region" aria-label="@T("z.list")">
                <table class="ttab">
                    <caption class="sr-only">@T("z.list")</caption>
                    <thead><tr><th scope="col">@T("m.zone")</th><th scope="col">@T("z.crop")</th><th scope="col">@T("z.area")</th><th scope="col">@T("z.devices")</th><th scope="col">@T("m.status")</th></tr></thead>
                    <tbody>
                    @foreach (var z in Model.Zones)
                    {
                        var tone = ViewFormat.Tone(z.Card.VpdBand);
                        <tr>
                            <th scope="row"><a href="#zone-@z.Card.Key">@z.Card.DisplayName</a></th>
                            <td>@z.CropType</td>
                            <td class="n">@string.Format(T("z.areaval"), ViewFormat.N(z.AreaSqMeters, 0))</td>
                            <td>@(z.Actuators.Count == 0 ? T("m.none") : string.Join(", ", z.Actuators.Select(a => a.Name)))</td>
                            <td>@if (z.Card.HasReading) {<span class="st @tone">@await Html.Icon(tone == "" ? "check" : "triangle-alert", 14)@ViewFormat.Band(lang, z.Card.VpdBand)</span>} else {<span class="st mute">@T("m.noreading")</span>}</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
    <p class="note">@T("card.modelled")@if (!Model.CanToggle) { <text> · @T("z.canttoggle")</text> }</p>
}

@section Scripts {
    <script src="~/js/charts.js" asp-append-version="true"></script>
    <script src="~/js/topology.js" asp-append-version="true"></script>
    <script type="module" src="~/js/live-zones.js" asp-append-version="true"></script>
}
