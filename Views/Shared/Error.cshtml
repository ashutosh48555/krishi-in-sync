@model ErrorViewModel
@{ ViewData["Title"] = Context.T("err.title"); }
<section class="auth center">
    <h1 class="sec-title">@Context.T("err.title")</h1>
    <p class="sub">@Context.T("err.body")</p>
    <a class="btn" asp-controller="Climate" asp-action="Dashboard">@Context.T("nav.dashboard")</a>
    @if (Model.ShowRequestId)
    {
        <p class="note">@Context.T("err.id"): <code>@Model.RequestId</code></p>
    }
</section>
