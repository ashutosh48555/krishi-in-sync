@model AlertsViewModel
@using AgriSyncIndia.Controllers
@{
    var lang = Model.CurrentLanguage;
    string T(string k) => Localizer.T(lang, k);
    ViewData["Title"] = T("a.title");
}
@section Head { <link rel="stylesheet" href="~/css/pages-a.css" asp-append-version="true" /> }

<div class="dh">
    <div class="dt">
        <h1 class="sec-title">@T("a.title")</h1>
        <p class="sub">@T("a.sub")</p>
    </div>
    <nav class="chips" aria-label="@T("a.filter")">
        @foreach (var f in AlertFilter.Names)
        {
            <a asp-action="Index" asp-route-filter="@f" class="fchip" aria-current="@(Model.Filter == f ? "true" : null)">@T("a.f." + f)<span class="cnt">@Model.Counts[f]</span></a>
        }
    </nav>
</div>

<div class="search-bar-row">
    <div class="search-box">
        @await Html.Icon("search", 16)
        <input type="search" id="alert-search" class="inp" placeholder="@T("al.search")" aria-label="Search alerts" />
    </div>
    <span id="search-count" class="search-count" aria-live="polite"></span>
    @if (Model.CanAcknowledge && Model.Alerts.Any(a => !a.IsAcknowledged))
    {
        <form asp-action="AcknowledgeAll" method="post" data-confirm="@T("al.ackall.confirm")">
            <input type="hidden" name="filter" value="@Model.Filter" />
            <button type="submit" class="btn sec sm">@await Html.Icon("check-check", 14)@T("al.ackall")</button>
        </form>
    }
</div>

<section class="card c12 listcard">
    <div id="alert-no-match" class="al" hidden><span class="ico watch">@await Html.Icon("triangle-alert")</span><div><b>@T("al.nomatch")</b><span>@T("al.nomatch.sub")</span></div></div>
    @if (Model.Alerts.Count == 0)
    {
        <div class="al"><span class="ico good">@await Html.Icon("check")</span><div><b>@T("a.empty")</b></div></div>
    }
    @foreach (var a in Model.Alerts)
    {
        var tone = a.IsAcknowledged ? "good" : ViewFormat.Tone(a.Severity);
        <article class="al@(a.IsAcknowledged ? " done" : "")" data-alert-text="@a.Title @a.Advice @a.ZoneName @a.Severity">
            <span class="ico @tone">@await Html.Icon(a.IsAcknowledged ? "check" : a.Severity == "Info" ? "bell" : "triangle-alert")</span>
            <div class="abody">
                <b>@a.Title</b>
                <span>@a.Advice</span>
                <span class="when">@T("al.sev." + a.Severity)@(a.ZoneName.Length > 0 ? " · " + a.ZoneName : "") · @a.TimeText IST@(a.IsAcknowledged ? " · " + T("a.resolved") : "")</span>
            </div>
            @if (Model.CanAcknowledge && !a.IsAcknowledged)
            {
                <form asp-action="Acknowledge" method="post" class="aact">
                    <input type="hidden" name="alertId" value="@a.Id" />
                    <input type="hidden" name="filter" value="@Model.Filter" />
                    <button type="submit" class="btn sec sm" aria-label="@string.Format(T("a.ackof"), a.Title)">@await Html.Icon("check", 14)@T("a.ack")</button>
                </form>
            }
        </article>
    }
</section>
@if (!Model.CanAcknowledge)
{
    <p class="note">@T("a.needrole")</p>
}
