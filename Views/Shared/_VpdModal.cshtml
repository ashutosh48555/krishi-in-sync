@* Agronomist Handbook & VPD Guide Dialog. Accessible modal dialog explaining microclimates. *@
@{
    var lang = Context.Lang();
    string T(string k) => Localizer.T(lang, k);
}
<dialog id="vpd-dialog" class="modal-dialog" aria-labelledby="vpd-modal-title">
    <div class="modal-content">
        <header class="modal-header">
            <div class="modal-title-wrap">
                <span class="modal-icon">@await Html.Icon("book-open", 20)</span>
                <div>
                    <h2 id="vpd-modal-title" class="modal-title">@T("vpd.m.title")</h2>
                    <p class="modal-sub">@T("vpd.m.sub")</p>
                </div>
            </div>
            <button type="button" class="modal-close" data-close-dialog aria-label="@T("toast.close")">
                @await Html.Icon("x", 18)
            </button>
        </header>

        <div class="modal-body">
            <!-- Concept Section -->
            <section class="modal-sec">
                <h3>@T("vpd.m.what")</h3>
                <p>@T("vpd.m.what.p")</p>
                <div class="formula-box">
                    <code>e<sub>s</sub> = 0.61078 &times; exp(17.27 &times; T / (T + 237.3))</code><br />
                    <code>VPD = e<sub>s</sub> &times; (1 - RH / 100)  [kPa]</code>
                </div>
            </section>

            <!-- Physiological Bands -->
            <section class="modal-sec">
                <h3>@T("vpd.m.bands")</h3>
                <div class="bands-grid">
                    <div class="band-card band-low">
                        <div class="band-hd">
                            <span class="st crit">@T("vpd.m.low.hd")</span>
                        </div>
                        <p>@T("vpd.m.low.impact")</p>
                        <p class="band-risk">@T("vpd.m.low.risk")</p>
                        <p class="band-fix">@T("vpd.m.low.fix")</p>
                    </div>

                    <div class="band-card band-opt">
                        <div class="band-hd">
                            <span class="st good">@T("vpd.m.opt.hd")</span>
                        </div>
                        <p>@T("vpd.m.opt.impact")</p>
                        <p class="band-risk">@T("vpd.m.opt.risk")</p>
                        <p class="band-fix">@T("vpd.m.opt.fix")</p>
                    </div>

                    <div class="band-card band-high">
                        <div class="band-hd">
                            <span class="st watch">@T("vpd.m.high.hd")</span>
                        </div>
                        <p>@T("vpd.m.high.impact")</p>
                        <p class="band-risk">@T("vpd.m.high.risk")</p>
                        <p class="band-fix">@T("vpd.m.high.fix")</p>
                    </div>
                </div>
            </section>

            <!-- Targeted Indian Crops -->
            <section class="modal-sec">
                <h3>@T("vpd.m.zones")</h3>
                <ul class="crops-list">
                    <li>@T("vpd.m.z1")</li>
                    <li>@T("vpd.m.z2")</li>
                    <li>@T("vpd.m.z3")</li>
                </ul>
            </section>
        </div>

        <footer class="modal-footer">
            <button type="button" class="btn sec" data-close-dialog>@T("vpd.m.close")</button>
            <a asp-controller="Climate" asp-action="Analytics" class="btn">@T("vpd.m.history")</a>
        </footer>
    </div>
</dialog>
